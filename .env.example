# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database Configuration
# Use DATABASE_URL for a single connection string (takes priority over individual vars)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/db_name?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=db_name
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Environment
ENV=development
