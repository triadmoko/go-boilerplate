# DATABASE_URL=postgresql://postgres:password@localhost:5432/db_name?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=jari
DB_SSLMODE=disable

# JWT Configuration
# openssl rand -hex 32
JWT_SECRET=

# Environment
ENV=development
